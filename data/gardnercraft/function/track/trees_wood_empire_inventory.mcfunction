# Checks one Trees and Wood Empire row per pass using current inventory plus carried shulker contents.
# Cycling rows avoids command-chain spikes when several shulker-heavy Empire rows are ready.
scoreboard players add @s gc_tw_empire_row_cursor 1
execute if score @s gc_tw_empire_row_cursor matches 21.. run scoreboard players set @s gc_tw_empire_row_cursor 1
execute if score @s gc_tw_empire_row_cursor matches 1 if entity @s[advancements={gardnercraft:trees_wood/logs/log_overachiever=true,gardnercraft:trees_wood/logs/log_empire=false}] run function gardnercraft:track/trees_wood_empire/logs
execute if score @s gc_tw_empire_row_cursor matches 2 if entity @s[advancements={gardnercraft:trees_wood/wood/wood_overachiever=true,gardnercraft:trees_wood/wood/wood_empire=false}] run function gardnercraft:track/trees_wood_empire/wood
execute if score @s gc_tw_empire_row_cursor matches 3 if entity @s[advancements={gardnercraft:trees_wood/stripped_logs/stripped_log_overachiever=true,gardnercraft:trees_wood/stripped_logs/stripped_log_empire=false}] run function gardnercraft:track/trees_wood_empire/stripped_logs
